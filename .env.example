# Porta da aplicação (padrão: 3005)
PORT=3005

# Modo de Banco de Dados:
# ==============================================================================
# 1) DESENVOLVIMENTO LOCAL (SQLite em arquivo local):
#    Se TURSO_DATABASE_URL não for informado, o ORION usa o banco SQLite local automaticamente.
SQLITE_PATH=./data/orion.db
# TURSO_DATABASE_URL=file:./data/orion.db

# 2) PRODUÇÃO / TURSO CLOUD (https://turso.tech/):
#    Preencha com a URL do seu database no Turso e o token de autenticação:
# TURSO_DATABASE_URL=libsql://[database-name]-[org].turso.io
# TURSO_AUTH_TOKEN=seu_token_de_autenticacao_turso

# Segredo para assinatura de JWTs
JWT_SECRET=orion_secret_key_change_in_production
